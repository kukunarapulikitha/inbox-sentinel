# Groq API key for the two LLM nodes (content/BEC reasoning + verdict fusion).
# Without it the graph still runs end to end on the deterministic rule path
# and the UI badge reads "LLM: fallback (rules)".
GROQ_API_KEY=

# Optional cross-provider fallback (Google AI Studio). The chain falls back to
# Gemini only when every Groq model fails.
GOOGLE_API_KEY=
